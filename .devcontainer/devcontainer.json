{
  "name": "Octopus Energy .NET Client",
  "image": "mcr.microsoft.com/devcontainers/base:3-ubuntu24.04",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": false,
      "installOhMyZsh": false,
      "username": "vscode",
      "upgradePackages": true
    },
    "ghcr.io/devcontainers/features/dotnet:2": {
      "version": "10.0",
      "additionalVersions": "8.0"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/stu-bell/devcontainer-features/cursor-cli:0": {}
  },
  "containerEnv": {
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
    "DOTNET_NOLOGO": "1",
    "NUGET_XMLDOC_MODE": "skip"
  },
  "remoteUser": "vscode",
  "postCreateCommand": "dotnet --info && dotnet restore OctopusEnergy.slnx",
  "customizations": {
    "vscode": {
      "settings": {
        "dotnet.defaultSolution": "OctopusEnergy.slnx",
        "terminal.integrated.defaultProfile.linux": "bash"
      },
      "extensions": [
        "ms-dotnettools.csdevkit",
        "ms-dotnettools.csharp",
        "ms-dotnettools.vscode-dotnet-runtime",
        "github.vscode-pull-request-github",
        "editorconfig.editorconfig",
        "streetsidesoftware.code-spell-checker"
      ]
    }
  }
}
